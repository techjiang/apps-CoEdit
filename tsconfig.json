{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "coedit": [
        "packages/coedit/src/index.ts"
      ],
      "coedit/react": [
        "packages/coedit-react/src/index.ts"
      ]
    },
    "types": [
      "vitest/globals",
      "react"
    ]
  },
  "include": [
    "packages/*/src/**/*",
    "examples/**/*.ts",
    "examples/**/*.tsx"
  ]
}